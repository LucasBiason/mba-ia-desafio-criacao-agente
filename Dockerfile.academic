FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_NO_PROGRESS=1 UV_PROJECT_ENVIRONMENT=/opt/aurora
WORKDIR /app
RUN pip install --no-cache-dir uv==0.13.7
COPY pyproject.toml uv.lock ./
COPY packages/microservice-toolkit ./packages/microservice-toolkit
COPY packages/aurora-toolkit ./packages/aurora-toolkit
RUN uv sync --locked --no-dev --no-install-project
COPY services ./services
COPY dados ./dados
RUN useradd --uid 10001 --no-create-home aurora
ENV PATH="/opt/aurora/bin:$PATH"
USER 10001
ENTRYPOINT ["python", "-m", "services.agent.academic"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
