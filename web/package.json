{
  "name": "residencial-aurora-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "test:all": "npm test",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run lint && npm run test:all && npm run build && npm run check:assets"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.0.8",
    "@eslint-react/eslint-plugin": "5.30.5"
  }
}
